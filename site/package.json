{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "sync-openapi": "cp ../internal/docsportal/openapi.yaml public/openapi.yaml",
    "validate-openapi": "ruby -e 'require \"yaml\"; YAML.load_file(\"../internal/docsportal/openapi.yaml\"); YAML.load_file(\"public/openapi.yaml\"); puts \"OpenAPI YAML is valid\"'",
    "dev": "npm run sync-openapi && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "npm run sync-openapi && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:pages": "npm run sync-openapi && npm run validate-openapi && next build --webpack",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
